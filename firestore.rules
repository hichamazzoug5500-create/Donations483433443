rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // 1. Organizations Collection
    match /organizations/{orgId} {
      allow read, write: if isAuth();
    }

    // 2. Branches Collection
    match /branches/{branchId} {
      allow read, write: if isAuth();
    }

    // 3. Users Collection
    match /users/{userId} {
      allow read, write: if isAuth();
    }

    // 4. Needs (Aid Requests)
    match /needs/{needId} {
      allow read, write: if isAuth();
    }

    // 5. Dispatches (Aid sent between branches)
    match /dispatches/{dispatchId} {
      allow read, write: if isAuth();
    }

    // 6. In-App Notifications Subcollection
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isAuth();
    }
  }
}
