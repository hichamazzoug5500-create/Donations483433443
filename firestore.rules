rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security and schema validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function validUserDoc(data) {
      return data.keys().hasOnly(['role', 'orgName', 'phone', 'city', 'notes', 'isProfileComplete', 'email', 'createdAt', 'updatedAt'])
        && (data.role in ['recipient', 'donor'])
        && (data.orgName is string && data.orgName.size() >= 2 && data.orgName.size() <= 120)
        && (data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30)
        && (data.city is string && data.city.size() >= 2 && data.city.size() <= 80);
    }

    function validRequestCreate(data) {
      return data.recipientId == request.auth.uid
        && (data.needDescription is string && data.needDescription.size() >= 3 && data.needDescription.size() <= 2500)
        && (data.category in ['food', 'clothing', 'medical', 'shelter', 'other'])
        && (data.urgency in ['high', 'medium', 'low'])
        && (data.status in ['open', 'in_progress'])
        && (data.orgName is string && data.orgName.size() <= 120)
        && (data.phone is string && data.phone.size() <= 30)
        && (data.quantity is string && data.quantity.size() <= 200)
        && (data.location.lat is number && data.location.lng is number);
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && validUserDoc(request.resource.data);
      allow delete: if false; // Disallow profile destruction
    }

    // 2. Aid Requests Collection
    match /requests/{requestId} {
      // Any authenticated organization or donor can read requests feed
      allow read: if isAuthenticated();

      // Recipient can create requests bound to their UID
      allow create: if isAuthenticated() && validRequestCreate(request.resource.data);

      // Owner can update their own request, OR an authenticated donor can commit/claim
      allow update: if isAuthenticated() && (
        // Case A: Owner updates details or status
        (request.auth.uid == resource.data.recipientId && request.resource.data.recipientId == resource.data.recipientId)
        ||
        // Case B: Donor commits to request (status becomes in_progress, assigned to donor)
        (request.resource.data.assignedDonorId == request.auth.uid && request.resource.data.status == 'in_progress')
        ||
        // Case C: Donor cancels their own commitment
        (resource.data.assignedDonorId == request.auth.uid && request.resource.data.status == 'open' && request.resource.data.assignedDonorId == null)
      );

      // Only the recipient creator can delete the request
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.recipientId;
    }

    // 3. Donor Responses & Commitments Collection
    match /responses/{responseId} {
      // Response can be read by the donor who made it, or by any authenticated member of the platform
      allow read: if isAuthenticated();

      // Creation strictly validated to match authenticated donor UID
      allow create: if isAuthenticated() 
        && request.resource.data.donorId == request.auth.uid
        && (request.resource.data.requestId is string)
        && (request.resource.data.pledgedQuantity is string && request.resource.data.pledgedQuantity.size() <= 250)
        && (request.resource.data.deliveryDate is string && request.resource.data.deliveryDate.size() <= 200)
        && (request.resource.data.donorNotes is string && request.resource.data.donorNotes.size() <= 1500);

      // Only the donor can delete/cancel their response record
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.donorId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.donorId;
    }

  }
}
