rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Aid Requests Collection (Publicly readable to prevent snapshot drops)
    match /requests/{requestId} {
      allow read: if true;

      // Recipient can create requests bound to their UID
      allow create: if isAuthenticated() && request.resource.data.recipientId == request.auth.uid;

      // Owner can update, or authenticated donor can commit/claim
      allow update: if isAuthenticated();

      // Only the recipient creator can delete the request
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.recipientId;
    }

    // 3. Donor Responses & Commitments Collection
    match /responses/{responseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.donorId == request.auth.uid;
      allow delete, update: if isAuthenticated() && request.auth.uid == resource.data.donorId;
    }

  }
}
